<Window x:Class="Lune.MiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lune" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Width="428" Height="200" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="True" Title="Lune · ミニプレイヤー" WindowStartupLocation="Manual" Closing="Mini_Closing" PreviewKeyDown="Mini_KeyDown">
 <Window.Style><StaticResource ResourceKey="{x:Type Window}"/></Window.Style>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <local:ArtworkConverter x:Key="Art"/>
  <Style x:Key="PinToggle" TargetType="ToggleButton">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="PinFace" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinFace" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="PinFace" Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="PinFace" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinFace" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,6,16,12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="68"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <local:SpectrumView Player="{Binding P}" Grid.Row="2" Grid.RowSpan="2" Opacity="0.13"/>
   <Grid MouseLeftButtonDown="Drag_Header" Background="Transparent"><TextBlock Text="◒   L U N E" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Content="&#xE718;" Width="28" Height="28" FontSize="12" Padding="5" Click="Pin_Click" ToolTip="常に手前に表示"/><Button Style="{StaticResource Icon}" Content="&#xE8A7;" Width="28" Height="28" FontSize="12" Padding="5" Click="Expand_Click" ToolTip="通常画面 (Ctrl+M)"/><Button Style="{StaticResource Icon}" Content="&#xE8BB;" Width="28" Height="28" FontSize="12" Padding="5" Click="Close_Click" ToolTip="終了"/></StackPanel></Grid>
   <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0">
    <Button x:Name="PrimaryMuteButton" Content="{Binding P.PrimaryOutputButtonLabel}" ToolTip="{Binding P.PrimaryOutputHint}" Click="PrimaryMute_Click" Padding="5,4" FontSize="10" MinWidth="57"/>
    <Button x:Name="SecondaryMuteButton" Content="{Binding P.SecondaryOutputButtonLabel}" ToolTip="{Binding P.SecondaryOutputHint}" IsEnabled="{Binding P.SecondaryOutputEnabled}" Click="SecondaryMute_Click" Padding="5,4" FontSize="10" MinWidth="57" Margin="3,0,0,0"/>
    <Button Style="{StaticResource Icon}" Content="&#xE7F5;" Width="28" Height="28" FontSize="12" Padding="5" Click="OutputDevice_Click" ToolTip="音声の出力先（出力1・出力2）"/>
   </StackPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
    <local:DiscArtwork x:Name="CurrentDisc" Source="{Binding P.Current.DisplayArtwork, Converter={StaticResource Art}}" IsPlaying="{Binding P.IsPlaying}" Width="56" Height="56" HorizontalAlignment="Left"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><local:MarqueeText Text="{Binding P.Current.Title, TargetNullValue=音楽を選んでください}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding P.Current.Title}"/><TextBlock Text="{Binding P.Current.Artist, TargetNullValue={x:Null}}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="2" Content="{Binding P.Current.Heart, TargetNullValue=♡}" FontSize="21" Foreground="{DynamicResource Accent}" Padding="3" Click="Favorite_Click" ToolTip="お気に入り"/>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding P.PositionText}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="SeekSlider" Maximum="{Binding P.Duration}" Value="{Binding P.Position, Mode=OneWay}" ToolTip="再生位置"/><TextBlock Grid.Column="2" Text="{Binding P.DurationText}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ShuffleButton" Style="{StaticResource Icon}" Content="&#xE8B1;" Width="27" FontSize="13" Padding="4" Click="Shuffle_Click" ToolTip="{Binding P.ShuffleLabel}"/><Button Style="{StaticResource Icon}" Content="&#xE892;" Width="31" FontSize="15" Padding="5" Click="Previous_Click" ToolTip="前の曲"/><Button Style="{StaticResource Icon}" Content="{Binding P.PlayIcon}" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Width="36" Height="36" Margin="3,0" Click="Play_Click" ToolTip="{Binding P.PlayLabel}"/><Button Style="{StaticResource Icon}" Content="&#xE893;" Width="31" FontSize="15" Padding="5" Click="Next_Click" ToolTip="次の曲"/><Button Style="{StaticResource Icon}" Content="&#xE71A;" Width="28" FontSize="13" Padding="4" Click="Stop_Click" ToolTip="停止"/><Button x:Name="RepeatButton" Style="{StaticResource Icon}" Content="{Binding P.RepeatIcon}" Width="27" FontSize="13" Padding="4" Click="Repeat_Click" ToolTip="{Binding P.RepeatLabel}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource Icon}" Content="{Binding P.VolumeIcon}" Width="27" FontSize="13" Padding="4" Click="Mute_Click" ToolTip="ミュート"/><Slider x:Name="VolumeSlider" Width="66" Minimum="{Binding P.VolumeMinimum}" Maximum="{Binding P.VolumeMaximum}" SmallChange="{Binding P.VolumeStep}" LargeChange="{Binding P.VolumeLargeStep}" Value="{Binding P.Volume, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{Binding P.VolumeLabel}"/><Button Style="{StaticResource Icon}" Content="&#xE8FD;" Width="31" FontSize="15" Padding="4" Click="Picker_Click" ToolTip="曲・マイリストを選択" Margin="6,0,0,0"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
