<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lune</AssemblyName>
    <PathMap>$(MSBuildProjectDirectory)=/_/Lune</PathMap>
    <Version>1.1.5</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Lune.ico</ApplicationIcon>
    <RestorePackagesPath>../.packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets/Lune.ico" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="UpdateHelper.ps1" LogicalName="Lune.UpdateHelper.ps1" /></ItemGroup>
</Project>
